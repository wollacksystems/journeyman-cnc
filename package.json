{
  "name": "journeyman-sim",
  "private": true,
  "version": "0.1.0",
  "description": "Synthetic CNC training environment: multi-camera Three.js rig with scripted scenarios and a render-then-ingest proof pipeline.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.180.0",
    "eslint": "^10.10.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "three": "^0.180.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "mediabunny": "^1.56.0"
  }
}
