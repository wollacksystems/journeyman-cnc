# Dependencies
node_modules/

# Build output
dist/

# Full-resolution renders + generated corpora (large local artifacts;
# smoke fixtures are committed)
renders/
corpora/

# Smoke test artifacts (screenshots + logs)
scripts/smoke-artifacts/

# Headless factory-run artifacts (exported corpora + screenshots + logs)
scripts/factory-artifacts/

# Brag-footage captures + the publishable bundle (large local artifacts; the
# published index rides on a GitHub release, fetched by `npm run footage -- fetch`)
scripts/footage-artifacts/
# corpus CLI bundle (regenerated by npm run corpus)
scripts/corpus.cli.mjs

# Visual-review beat captures (generated by scripts/review-beats.mts)
review/

# Bundled verification harness (built from scripts/verify-cam-rig.mts)
scripts/verify-cam-rig.bundle.mjs
scripts/verify-scenarios.bundle.mjs

# Generated API reference (TypeDoc; published to GitHub Pages by CI, never committed)
docs/api/

# Environment / secrets (.env.smoke is committed smoke capture config, not secrets)
.env
.env.*
!.env.smoke

# Editor / OS
.DS_Store
Thumbs.db
